<UserControl x:Class="AbsenSholat.DataSiswaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F8FAFC">

    <UserControl.Resources>
        <!-- Modern Card Style (consistent with Beranda/Jadwal) -->
        <Style x:Key="DataSiswaCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" 
                                      Color="#000000" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon Button Style (consistent with Jadwal page) -->
        <Style x:Key="ActionIconButton" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Search TextBox Style -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>

        <!-- Filter ComboBox Style -->
        <Style x:Key="FilterComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32">

            <!-- Page Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Data Siswa" FontSize="28" FontWeight="Bold" 
                           Foreground="#1E293B" VerticalAlignment="Center"/>

                <!-- + Tambah Siswa Button -->
                <Border Grid.Column="1" Background="#16A34A" CornerRadius="10" Padding="18,10" 
                        Cursor="Hand" MouseLeftButtonUp="OnTambahSiswaClick">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#16A34A" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="White" 
                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Tambah Siswa" FontSize="13" FontWeight="SemiBold" 
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Search and Filter Bar -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" 
                        BorderThickness="1" Padding="4,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" 
                                   Margin="10,0,8,0" Foreground="#94A3B8"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" 
                                 Text="" Background="Transparent" BorderThickness="0"
                                 Padding="4,10" FontSize="13" Foreground="#334155"
                                 VerticalContentAlignment="Center"
                                 TextChanged="OnSearchTextChanged"/>
                    </Grid>
                    <!-- Placeholder text -->
                </Border>

                <!-- Jurusan Filter -->
                <ComboBox x:Name="FilterJurusan" Grid.Column="2" Style="{StaticResource FilterComboStyle}"
                          SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="Semua Jurusan" IsSelected="True"/>
                    <ComboBoxItem Content="RPL"/>
                    <ComboBoxItem Content="TKJ"/>
                    <ComboBoxItem Content="TEI"/>
                    <ComboBoxItem Content="TAV"/>
                    <ComboBoxItem Content="DKV"/>
                    <ComboBoxItem Content="Animasi"/>
                    <ComboBoxItem Content="Mekatronika"/>
                </ComboBox>

                <!-- Kelas Filter -->
                <ComboBox x:Name="FilterKelas" Grid.Column="4" Style="{StaticResource FilterComboStyle}"
                          SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="Semua Kelas" IsSelected="True"/>
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="11"/>
                    <ComboBoxItem Content="12"/>
                </ComboBox>
            </Grid>

            <!-- Data Table Card -->
            <Border Style="{StaticResource DataSiswaCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="16,16,0,0" Padding="0">
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="NO." FontWeight="SemiBold" FontSize="13" 
                                       Foreground="#475569" Margin="20,14" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="NIS" FontWeight="SemiBold" FontSize="13" 
                                       Foreground="#475569" Margin="0,14"/>
                            <TextBlock Grid.Column="2" Text="NAMA" FontWeight="SemiBold" FontSize="13" 
                                       Foreground="#475569" Margin="0,14"/>
                            <TextBlock Grid.Column="3" Text="KELAS" FontWeight="SemiBold" FontSize="13" 
                                       Foreground="#475569" Margin="0,14"/>
                            <TextBlock Grid.Column="4" Text="STATUS" FontWeight="SemiBold" FontSize="13" 
                                       Foreground="#475569" Margin="0,14" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="AKSI" FontWeight="SemiBold" FontSize="13" 
                                       Foreground="#475569" Margin="0,14" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Table Body (ItemsControl) -->
                    <ItemsControl x:Name="SiswaTable" Grid.Row="1">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"
                                        Background="{Binding RowBackground}">
                                    <Grid Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- NO -->
                                        <TextBlock Grid.Column="0" Text="{Binding No}" FontSize="13" 
                                                   Foreground="#334155" Margin="20,12" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- NIS -->
                                        <TextBlock Grid.Column="1" Text="{Binding Nis}" FontSize="13" 
                                                   Foreground="#334155" Margin="0,12" 
                                                   VerticalAlignment="Center" FontWeight="Medium"/>

                                        <!-- NAMA -->
                                        <TextBlock Grid.Column="2" Text="{Binding NamaSiswa}" FontSize="13" 
                                                   Foreground="#334155" Margin="0,12" 
                                                   VerticalAlignment="Center"/>

                                        <!-- KELAS -->
                                        <TextBlock Grid.Column="3" Text="{Binding Kelas}" FontSize="13" 
                                                   Foreground="#334155" Margin="0,12" 
                                                   VerticalAlignment="Center"/>

                                        <!-- STATUS (Detail link) -->
                                        <TextBlock Grid.Column="4" Text="Detail" FontSize="13" 
                                                   Foreground="#3B82F6" FontWeight="SemiBold"
                                                   Cursor="Hand" Margin="0,12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextDecorations="Underline"/>

                                        <!-- AKSI (Delete + Edit) -->
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" 
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Margin="0,8">
                                            <!-- Delete -->
                                            <Border Background="#FEE2E2" CornerRadius="8" 
                                                    Width="32" Height="32" Cursor="Hand" Margin="0,0,6,0"
                                                    MouseLeftButtonUp="OnDeleteSiswaClick"
                                                    Tag="{Binding Nis}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="0.8"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="🗑️" FontSize="14" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <!-- Edit -->
                                            <Border Background="#DBEAFE" CornerRadius="8" 
                                                    Width="32" Height="32" Cursor="Hand"
                                                    MouseLeftButtonUp="OnEditSiswaClick"
                                                    Tag="{Binding Nis}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="0.8"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="✏️" FontSize="14" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
