<UserControl x:Class="AbsenSholat.PresensiPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F8FAFC">

    <UserControl.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="PresensiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" 
                                      Color="#000000" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter ComboBox Style -->
        <Style x:Key="FilterComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>

        <!-- Stat Mini Card Style -->
        <Style x:Key="StatMiniCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" 
                                      Color="#000000" Opacity="0.05"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32">

            <!-- Page Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Input Presensi" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Kelola data presensi sholat siswa" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- + Tambah Presensi Button -->
                <Border Grid.Column="1" CornerRadius="12" Padding="20,12" 
                        Cursor="Hand" MouseLeftButtonUp="OnTambahPresensiClick" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#16A34A" Offset="0"/>
                            <GradientStop Color="#22C55E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Color="#16A34A" Opacity="0.35"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋" FontSize="15" FontWeight="Bold" Foreground="White" 
                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Tambah Presensi" FontSize="13" FontWeight="SemiBold" 
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Search and Filter Bar -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" 
                        BorderThickness="1" Padding="4,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" 
                                   Margin="10,0,8,0" Foreground="#94A3B8"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" 
                                 Text="" Background="Transparent" BorderThickness="0"
                                 Padding="4,10" FontSize="13" Foreground="#334155"
                                 VerticalContentAlignment="Center"
                                 TextChanged="OnSearchTextChanged"/>
                    </Grid>
                </Border>

                <!-- Jurusan Filter -->
                <ComboBox x:Name="FilterJurusan" Grid.Column="2" Style="{StaticResource FilterComboStyle}"
                          SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="Semua Jurusan" IsSelected="True"/>
                    <ComboBoxItem Content="RPL"/>
                    <ComboBoxItem Content="TKJ"/>
                    <ComboBoxItem Content="TEI"/>
                    <ComboBoxItem Content="TAV"/>
                    <ComboBoxItem Content="DKV"/>
                    <ComboBoxItem Content="Animasi"/>
                    <ComboBoxItem Content="Mekatronika"/>
                </ComboBox>

                <!-- Kelas Filter -->
                <ComboBox x:Name="FilterKelas" Grid.Column="4" Style="{StaticResource FilterComboStyle}"
                          SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="Semua Kelas" IsSelected="True"/>
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="11"/>
                    <ComboBoxItem Content="12"/>
                </ComboBox>
            </Grid>

            <!-- Data Table Card -->
            <Border Style="{StaticResource PresensiCardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F1F5F9" Offset="0"/>
                                <GradientStop Color="#E8EDF5" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.6*"/>
                                <ColumnDefinition Width="0.7*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="NO." FontWeight="SemiBold" FontSize="12" 
                                       Foreground="#475569" Margin="16,14" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="NIS" FontWeight="SemiBold" FontSize="12" 
                                       Foreground="#475569" Margin="0,14"/>
                            <TextBlock Grid.Column="2" Text="NAMA" FontWeight="SemiBold" FontSize="12" 
                                       Foreground="#475569" Margin="0,14"/>
                            <TextBlock Grid.Column="3" Text="KELAS" FontWeight="SemiBold" FontSize="12" 
                                       Foreground="#475569" Margin="0,14"/>
                            <TextBlock Grid.Column="4" Text="JAM" FontWeight="SemiBold" FontSize="12" 
                                       Foreground="#475569" Margin="0,14" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="STATUS" FontWeight="SemiBold" FontSize="12" 
                                       Foreground="#475569" Margin="0,14" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="AKSI" FontWeight="SemiBold" FontSize="12" 
                                       Foreground="#475569" Margin="0,14" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Table Body -->
                    <ItemsControl x:Name="PresensiTable" Grid.Row="1">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"
                                        Background="{Binding RowBackground}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F0F5FF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="0.6*"/>
                                            <ColumnDefinition Width="0.7*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- NO -->
                                        <TextBlock Grid.Column="0" Text="{Binding No}" FontSize="13" 
                                                   Foreground="#334155" Margin="16,12" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- NIS -->
                                        <TextBlock Grid.Column="1" Text="{Binding Nis}" FontSize="13" 
                                                   Foreground="#334155" Margin="0,12" 
                                                   VerticalAlignment="Center" FontWeight="Medium"/>

                                        <!-- NAMA -->
                                        <TextBlock Grid.Column="2" Text="{Binding NamaSiswa}" FontSize="13" 
                                                   Foreground="#334155" Margin="0,12" 
                                                   VerticalAlignment="Center"/>

                                        <!-- KELAS -->
                                        <TextBlock Grid.Column="3" Text="{Binding Kelas}" FontSize="13" 
                                                   Foreground="#334155" Margin="0,12" 
                                                   VerticalAlignment="Center"/>

                                        <!-- JAM -->
                                        <TextBlock Grid.Column="4" Text="{Binding Jam}" FontSize="13" 
                                                   Foreground="#64748B" Margin="0,12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- STATUS Badge -->
                                        <Border Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="{Binding StatusBackground}" CornerRadius="6" 
                                                Padding="10,4" Margin="0,8">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding StatusForeground}" 
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- AKSI (Detail + Edit) -->
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" 
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Margin="0,8">
                                            <!-- Detail -->
                                            <Border Background="#DBEAFE" CornerRadius="6" 
                                                    Padding="10,5" Cursor="Hand" Margin="0,0,6,0"
                                                    MouseLeftButtonUp="OnDetailClick"
                                                    Tag="{Binding Nis}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#BFDBFE"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Detail" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#3B82F6" HorizontalAlignment="Center"/>
                                            </Border>
                                            <!-- Edit -->
                                            <Border Background="#F0FDF4" CornerRadius="6" 
                                                    Padding="10,5" Cursor="Hand"
                                                    MouseLeftButtonUp="OnEditPresensiClick"
                                                    Tag="{Binding Nis}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Edit" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#16A34A" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
