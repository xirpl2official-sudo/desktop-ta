<UserControl x:Class="AbsenSholat.JadwalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F8FAFC">

    <UserControl.Resources>
        <!-- Modern Card Style (same as AdminDashboard) -->
        <Style x:Key="JadwalCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" 
                                      Color="#000000" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Edit/Delete Icon Button -->
        <Style x:Key="IconButton" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32">

            <!-- Page Header -->
            <TextBlock Text="JADWAL SHOLAT" FontSize="28" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,24"/>
            
            <!-- Giliran Sholat Table Card -->
            <Border Style="{StaticResource JadwalCardStyle}" Padding="24" Margin="0,0,0,28">
                <StackPanel>
                    <!-- Card Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📋" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Jadwal Sholat Dhuha - Giliran Sholat" FontSize="18" FontWeight="SemiBold" 
                                       Foreground="#1E293B" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- Edit Mode Toggle Button -->
                            <Button x:Name="BtnEditDhuha" Click="OnEditDhuhaClick" Margin="0,0,8,0" Background="Transparent" BorderThickness="0" Padding="0">
                                <Border x:Name="BtnEditDhuhaBorder" Style="{StaticResource IconButton}" Background="#DBEAFE">
                                    <TextBlock Text="✏️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Button>
                            
                            <!-- Save Button (Initially Hidden) -->
                            <Button x:Name="BtnSaveDhuha" Click="OnSaveDhuhaClick" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="0">
                                <Border Style="{StaticResource IconButton}" Background="#DCFCE7">
                                    <TextBlock Text="💾" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Table Container -->
                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <!-- Header Row -->
                            <Grid Background="#F1F5F9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                                    <TextBlock Text="Hari" FontWeight="SemiBold" Foreground="#475569"/>
                                </Border>
                                <Border Grid.Column="1" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                                    <TextBlock Text="Konsentrasi Keahlian 1" FontWeight="SemiBold" Foreground="#475569"/>
                                </Border>
                                <Border Grid.Column="2" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="Konsentrasi Keahlian 2" FontWeight="SemiBold" Foreground="#475569"/>
                                </Border>
                            </Grid>

                            <!-- Data Rows -->
                            <ItemsControl x:Name="DhuhaTableItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="{Binding RowBackground}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Border Grid.Column="0" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                                                <TextBlock Text="{Binding Day}" Foreground="#334155"/>
                                            </Border>
                                            
                                            <!-- Slot 1 -->
                                            <Border Grid.Column="1" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1" 
                                                    Cursor="Hand" MouseLeftButtonDown="OnSlotClick" Tag="{Binding Slot1Tag}">
                                                <TextBlock Text="{Binding Jurusan1}" Foreground="{Binding Color1}" TextWrapping="Wrap"/>
                                            </Border>
                                            
                                            <!-- Slot 2 -->
                                            <Border Grid.Column="2" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                                                    Cursor="Hand" MouseLeftButtonDown="OnSlotClick" Tag="{Binding Slot2Tag}">
                                                <TextBlock Text="{Binding Jurusan2}" Foreground="{Binding Color2}" TextWrapping="Wrap"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Prayer Summary Cards Row -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Dhuha Card -->
                <Border Grid.Column="0" Style="{StaticResource JadwalCardStyle}" Background="#EFF6FF" Cursor="Hand" Tag="Dhuha" MouseLeftButtonDown="OnPrayerCardClick" Padding="20">
                    <StackPanel>
                        <TextBlock Text="🌅 Dhuha" FontSize="14" Foreground="#1D4ED8" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock x:Name="TxtDhuhaTime" Text="07:00 - 08:30" FontSize="20" FontWeight="Bold" Foreground="#1E3A8A"/>
                        <TextBlock Text="Senin - Jumat" FontSize="12" Foreground="#60A5FA" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Dhuhur Card -->
                <Border Grid.Column="2" Style="{StaticResource JadwalCardStyle}" Background="#F0FDF4" Cursor="Hand" Tag="Dzuhur" MouseLeftButtonDown="OnPrayerCardClick" Padding="20">
                    <StackPanel>
                        <TextBlock Text="☀️ Zuhur" FontSize="14" Foreground="#15803D" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock x:Name="TxtZuhurTime" Text="12:00 - 13:00" FontSize="20" FontWeight="Bold" Foreground="#064E3B"/>
                        <TextBlock Text="Senin - Kamis" FontSize="12" Foreground="#4ADE80" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Jumat Card -->
                <Border Grid.Column="4" Style="{StaticResource JadwalCardStyle}" Background="#FEF2F2" Cursor="Hand" Tag="Jumat" MouseLeftButtonDown="OnPrayerCardClick" Padding="20">
                    <StackPanel>
                        <TextBlock Text="🕌 Jum'at" FontSize="14" Foreground="#B91C1C" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock x:Name="TxtJumatTime" Text="12:00 - 13:00" FontSize="20" FontWeight="Bold" Foreground="#7F1D1D"/>
                        <TextBlock Text="Khusus Jumat" FontSize="12" Foreground="#F87171" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
