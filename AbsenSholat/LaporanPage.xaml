<UserControl x:Class="AbsenSholat.LaporanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F8FAFC">

    <UserControl.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="LaporanCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" 
                                      Color="#000000" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter ComboBox Style -->
        <Style x:Key="FilterComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32">

            <!-- Page Header -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Laporan Presensi" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Ringkasan &amp; ekspor data presensi sholat" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Unduh Laporan Button -->
                <Border Grid.Column="1" CornerRadius="12" Padding="20,12" 
                        Cursor="Hand" MouseLeftButtonUp="OnUnduhLaporanClick" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#16A34A" Offset="0"/>
                            <GradientStop Color="#22C55E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Color="#16A34A" Opacity="0.35"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📥" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Unduh Laporan" FontSize="13" FontWeight="SemiBold" 
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Ringkasan Periode Card -->
            <Border Style="{StaticResource LaporanCardStyle}" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="📊" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Ringkasan Periode" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Kehadiran -->
                        <Border Grid.Column="0" CornerRadius="14" Padding="20,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#DCFCE7" Offset="0"/>
                                    <GradientStop Color="#F0FDF4" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="StatKehadiranText" Text="90" FontSize="32" FontWeight="Bold" 
                                           Foreground="#16A34A" HorizontalAlignment="Center"/>
                                <TextBlock Text="Kehadiran" FontSize="12" Foreground="#15803D" 
                                           HorizontalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <!-- Sakit -->
                        <Border Grid.Column="2" CornerRadius="14" Padding="20,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#DBEAFE" Offset="0"/>
                                    <GradientStop Color="#EFF6FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="StatSakitText" Text="8" FontSize="32" FontWeight="Bold" 
                                           Foreground="#2563EB" HorizontalAlignment="Center"/>
                                <TextBlock Text="Sakit" FontSize="12" Foreground="#1D4ED8" 
                                           HorizontalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <!-- Izin -->
                        <Border Grid.Column="4" CornerRadius="14" Padding="20,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FEF3C7" Offset="0"/>
                                    <GradientStop Color="#FFFBEB" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="StatIzinText" Text="10" FontSize="32" FontWeight="Bold" 
                                           Foreground="#D97706" HorizontalAlignment="Center"/>
                                <TextBlock Text="Izin" FontSize="12" Foreground="#B45309" 
                                           HorizontalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <!-- Alpha -->
                        <Border Grid.Column="6" CornerRadius="14" Padding="20,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FEE2E2" Offset="0"/>
                                    <GradientStop Color="#FEF2F2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="StatAlphaText" Text="5" FontSize="32" FontWeight="Bold" 
                                           Foreground="#DC2626" HorizontalAlignment="Center"/>
                                <TextBlock Text="Alpha" FontSize="12" Foreground="#B91C1C" 
                                           HorizontalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Laporan Absensi Filter Card -->
            <Border Style="{StaticResource LaporanCardStyle}" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <TextBlock Text="🔎" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Laporan Absensi" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tanggal Awal -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tanggal Awal" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="#475569" Margin="0,0,0,6"/>
                            <DatePicker x:Name="DateFrom" FontSize="13" 
                                        SelectedDateChanged="OnFilterChanged"
                                        BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,8"/>
                        </StackPanel>

                        <!-- Tanggal Akhir -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tanggal Akhir" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="#475569" Margin="0,0,0,6"/>
                            <DatePicker x:Name="DateTo" FontSize="13" 
                                        SelectedDateChanged="OnFilterChanged"
                                        BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,8"/>
                        </StackPanel>

                        <!-- Jurusan -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Jurusan" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="#475569" Margin="0,0,0,6"/>
                            <ComboBox x:Name="FilterJurusan" Style="{StaticResource FilterComboStyle}"
                                      SelectionChanged="OnFilterChanged">
                                <ComboBoxItem Content="Semua Jurusan" IsSelected="True"/>
                                <ComboBoxItem Content="RPL"/>
                                <ComboBoxItem Content="TKJ"/>
                                <ComboBoxItem Content="TEI"/>
                                <ComboBoxItem Content="TAV"/>
                                <ComboBoxItem Content="DKV"/>
                                <ComboBoxItem Content="Animasi"/>
                                <ComboBoxItem Content="Mekatronika"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Kelas -->
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Kelas" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="#475569" Margin="0,0,0,6"/>
                            <ComboBox x:Name="FilterKelas" Style="{StaticResource FilterComboStyle}"
                                      SelectionChanged="OnFilterChanged">
                                <ComboBoxItem Content="Semua Kelas" IsSelected="True"/>
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="11"/>
                                <ComboBoxItem Content="12"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Data Presensi Table Card -->
            <Border Style="{StaticResource LaporanCardStyle}" Padding="0" ClipToBounds="True">
                <StackPanel>
                    <!-- Table Card Header -->
                    <Grid Margin="24,20,24,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Data Presensi" FontSize="18" FontWeight="SemiBold" 
                                       Foreground="#1E293B" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Export Excel Button -->
                        <Border Grid.Column="1" CornerRadius="10" Padding="16,8" Cursor="Hand"
                                MouseLeftButtonUp="OnExportExcelClick">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#3B82F6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="#2563EB" Opacity="0.25"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Export Excel" FontSize="12" FontWeight="SemiBold" 
                                           Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Table Header -->
                    <Border Padding="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F1F5F9" Offset="0"/>
                                <GradientStop Color="#E8EDF5" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.7*"/>
                                <ColumnDefinition Width="0.7*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="NO." FontWeight="SemiBold" FontSize="12" 
                                       Foreground="#475569" Margin="16,14" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="TANGGAL" FontWeight="SemiBold" FontSize="12" 
                                       Foreground="#475569" Margin="0,14"/>
                            <TextBlock Grid.Column="2" Text="NIS" FontWeight="SemiBold" FontSize="12" 
                                       Foreground="#475569" Margin="0,14"/>
                            <TextBlock Grid.Column="3" Text="NAMA" FontWeight="SemiBold" FontSize="12" 
                                       Foreground="#475569" Margin="0,14"/>
                            <TextBlock Grid.Column="4" Text="KELAS" FontWeight="SemiBold" FontSize="12" 
                                       Foreground="#475569" Margin="0,14"/>
                            <TextBlock Grid.Column="5" Text="SALAT" FontWeight="SemiBold" FontSize="12" 
                                       Foreground="#475569" Margin="0,14" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="STATUS" FontWeight="SemiBold" FontSize="12" 
                                       Foreground="#475569" Margin="0,14" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Table Body -->
                    <ItemsControl x:Name="LaporanTable">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"
                                        Background="{Binding RowBackground}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F0F5FF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="0.7*"/>
                                            <ColumnDefinition Width="0.7*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- NO -->
                                        <TextBlock Grid.Column="0" Text="{Binding No}" FontSize="13" 
                                                   Foreground="#334155" Margin="16,12" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- TANGGAL -->
                                        <TextBlock Grid.Column="1" Text="{Binding Tanggal}" FontSize="13" 
                                                   Foreground="#334155" Margin="0,12" 
                                                   VerticalAlignment="Center"/>

                                        <!-- NIS -->
                                        <TextBlock Grid.Column="2" Text="{Binding Nis}" FontSize="13" 
                                                   Foreground="#334155" Margin="0,12" 
                                                   VerticalAlignment="Center" FontWeight="Medium"/>

                                        <!-- NAMA -->
                                        <TextBlock Grid.Column="3" Text="{Binding NamaSiswa}" FontSize="13" 
                                                   Foreground="#334155" Margin="0,12" 
                                                   VerticalAlignment="Center"/>

                                        <!-- KELAS -->
                                        <TextBlock Grid.Column="4" Text="{Binding Kelas}" FontSize="13" 
                                                   Foreground="#334155" Margin="0,12" 
                                                   VerticalAlignment="Center"/>

                                        <!-- SALAT -->
                                        <TextBlock Grid.Column="5" Text="{Binding JenisSalat}" FontSize="13" 
                                                   Foreground="#64748B" Margin="0,12" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- STATUS Badge -->
                                        <Border Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="{Binding StatusBackground}" CornerRadius="6" 
                                                Padding="10,4" Margin="0,8">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding StatusForeground}" 
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
